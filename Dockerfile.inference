FROM python:3.12-slim

WORKDIR /app

# System deps for OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Python deps
RUN pip install --no-cache-dir \
    torch torchvision \
    opencv-python-headless \
    gradio \
    pydicom

# Source files needed for inference
COPY config.py preprocess.py classify_model.py full_model.py gradio_app.py ./

# Model weights are mounted at runtime — placeholders so the paths exist
RUN mkdir -p /app/models /app/classifier_model

EXPOSE 7860

ENV GRADIO_SERVER_PORT=7860

CMD ["python", "gradio_app.py"]
